# OpenAI API key (required)
OPENAI_API_KEY=sk-...

# LLM model to use (default: gpt-4o)
LLM_MODEL=gpt-4o
LLM_TEMPERATURE=0.3

# Embedding model (default: text-embedding-3-small)
EMBEDDING_MODEL=text-embedding-3-small

# ── Qdrant knowledge base mode ────────────────────────────────────────────────
# Choose ONE of: local | selfhosted | cloud
QDRANT_MODE=local

# local — file-based, single machine, no extra service needed
QDRANT_LOCAL_PATH=./qdrant_data

# selfhosted — point to a running Qdrant container (e.g. via docker-compose)
# QDRANT_MODE=selfhosted
# QDRANT_HOST=qdrant
# QDRANT_PORT=6333

# cloud — Qdrant Cloud (https://cloud.qdrant.io)
# QDRANT_MODE=cloud
# QDRANT_URL=https://xyz-123.eu-central.aws.cloud.qdrant.io:6333
# QDRANT_API_KEY=your-qdrant-cloud-api-key

QDRANT_COLLECTION_NAME=documents

# CORS — comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=["http://localhost:3000"]
